[Unit]
Description=Infoblox PortunusDnsLogs (DFP) → Graylog (per-host MCP page)
After=network-online.target graylog-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=mcp-poller
Group=mcp-poller
EnvironmentFile=/etc/mcp-poller/env
ExecStart=/usr/bin/python3 /opt/mcp-poller/mcp_poller.py
ReadWritePaths=/var/lib/mcp-poller

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
